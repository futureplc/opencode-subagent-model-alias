{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-plugin-subagent-model-alias",
  "version": "0.1.0",
  "description": "opencode plugin: dispatch subagents on an allow-listed model by appending @alias to subagent_type in the native task tool",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "engines": {
    "opencode": ">=1.17.18"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "model-routing",
    "subagents"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.17.18",
    "@opencode-ai/sdk": "^1.17.18"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.7.0"
  }
}
